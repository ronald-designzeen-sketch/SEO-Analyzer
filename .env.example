# SEO Analyzer Environment Variables
# Copy this file to .env.local and configure your API keys

# =============================================================================
# GOOGLE PAGESPEED INSIGHTS API
# =============================================================================
# Get your API key from: https://developers.google.com/speed/docs/insights/v5/get-started
# Optional - if not provided, the app will use realistic mock performance data
GOOGLE_PAGESPEED_API_KEY=your_google_pagespeed_api_key_here

# =============================================================================
# SEO API INTEGRATIONS (Optional)
# =============================================================================
# The app provides intelligent mock data if these are not configured
# Replace with real API calls when keys are available

# Ahrefs API - https://ahrefs.com/api
AHREFS_API_KEY=your_ahrefs_api_key_here

# Moz API - https://moz.com/api
MOZ_API_KEY=your_moz_api_key_here
MOZ_SECRET_KEY=your_moz_secret_key_here

# SEMrush API - https://www.semrush.com/api/
SEMRUSH_API_KEY=your_semrush_api_key_here

# Majestic API - https://majestic.com/api
MAJESTIC_API_KEY=your_majestic_api_key_here

# DataForSEO API - https://dataforseo.com/apis
DATAFORSEO_LOGIN=your_dataforseo_login_here
DATAFORSEO_PASSWORD=your_dataforseo_password_here

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================
# SQLite (default) - no configuration needed
# PostgreSQL example: postgresql://username:password@localhost:5432/seo_analyzer
# Firebase example: configure in firebase config
DATABASE_URL=sqlite:./seo_analyzer.db

# =============================================================================
# LEAD CAPTURE & CRM INTEGRATION
# =============================================================================
# Email service for lead notifications
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password

# Webhook URL for CRM integration (optional)
CRM_WEBHOOK_URL=https://your-crm.com/webhook/leads

# =============================================================================
# APPLICATION SETTINGS
# =============================================================================
# Next.js configuration
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your_nextauth_secret_here

# Agency branding
AGENCY_NAME="Design Zeen Marketing Agency"
AGENCY_EMAIL=info@designzeen.com
AGENCY_WEBSITE=https://designzeen.com

# =============================================================================
# DEVELOPMENT SETTINGS
# =============================================================================
# Set to 'development' for detailed logging
NODE_ENV=production

# Enable/disable mock data (useful for testing)
USE_MOCK_DATA=true

# API rate limiting
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=3600

# =============================================================================
# SECURITY SETTINGS
# =============================================================================
# CORS origins (comma-separated)
ALLOWED_ORIGINS=http://localhost:3000,https://yourdomain.com

# API key for internal services (generate a random string)
INTERNAL_API_KEY=your_internal_api_key_here

